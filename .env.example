# ==============================================================================
# Digital Gram Panchayat - Environment Configuration Template
# Copy this file to .env and provide secrets suitable for your environment.
# NEVER commit .env with real credentials to version control.
# ==============================================================================

# Django Secret Key (generate a cryptographically strong secret in production)
SECRET_KEY=django-insecure-change-this-in-production-use-a-50-char-random-string

# Debug Mode (set to False for production)
DEBUG=True

# Allowed Hosts (comma-separated list of host/domain names)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# In development/test, leave unset to automatically fall back to local SQLite.
# For production (PostgreSQL), provide the connection URL:
# DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?sslmode=require
DATABASE_URL=

# Security & HTTPS Configuration (Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Rate Limiting & Throttling
LOGIN_RATELIMIT_MAX_ATTEMPTS=5
LOGIN_RATELIMIT_TIMEOUT_SECONDS=300

# Google OAuth 2.0 Credentials (Optional)
# If configuring Google Social Auth, set client credentials here:
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
